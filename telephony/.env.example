# Файл необязателен: без него работают значения по умолчанию из docker-compose.yml.
# Для класса/демо — скопировать в .env и сменить пароли.
AMI_PASSWORD=change_me_strong_password
SIP_ALICE_PASSWORD=change_me_alice_password
SIP_BOB_PASSWORD=change_me_bob_password

# Адрес, по которому ВАШ софтфон видит машину с Docker (нужен для RTP/звука,
# см. комментарий в asterisk/conf/pjsip.conf):
#   - софтфон на этой же машине            -> 127.0.0.1 (значение по умолчанию)
#   - софтфон на другом устройстве в сети  -> LAN-IP этой машины
EXTERNAL_MEDIA_ADDRESS=127.0.0.1

# Порт хоста для SIP (левая часть ports в docker-compose.yml). Asterisk
# подставляет его в Contact/Via; при несовпадении звонок рвётся на ~32 с.
EXTERNAL_SIGNALING_PORT=5063

# --- Этап 5: voice-service (STT/TTS) ---------------------------------
# Порт HTTP API на хосте: http://localhost:8091/health
VOICE_SERVICE_PORT=8091
# Движки: faster_whisper | mock  и  silero | piper | mock.
# mock не требует моделей (STT отдаёт фиксированный текст, TTS — тон).
STT_ENGINE=faster_whisper
# Silero — мягкие естественные голоса (лицензия моделей CC BY-NC: некоммерческое использование);
# для коммерческого использования — piper (MIT)
TTS_ENGINE=silero
# Silero не загрузился — запасной движок (затем ENGINE_FALLBACK)
TTS_FALLBACK_ENGINE=piper
STT_LANGUAGE=ru
# tiny | base | small | medium. small — компромисс качество/скорость на CPU.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Silero: модель и голоса собеседников. Каждому собеседнику — свой голос своего пола (по имени).
SILERO_MODEL=v5_ru
SILERO_VOICES_FEMALE=baya,kseniya,xenia
SILERO_VOICES_MALE=aidar,eugene
# Piper (запасной): голос по умолчанию и голоса по категории, можно несколько через запятую
PIPER_VOICE=ru_RU-irina-medium
PIPER_VOICE_FEMALE=ru_RU-irina-medium
PIPER_VOICE_MALE=ru_RU-dmitri-medium,ru_RU-denis-medium
# Нет моделей при старте -> скачать (~0.8 ГБ, интернет нужен один раз)
MODELS_AUTO_DOWNLOAD=1
# Модели так и не появились -> заглушки mock (звонки идут, /health: degraded); none — не запускаться
ENGINE_FALLBACK=mock
# Параллельных распознаваний STT (больше — быстрее при многих звонках, больше CPU)
WHISPER_WORKERS=2
# 8000 = формат для Asterisk STREAM FILE
TTS_SAMPLE_RATE=8000

# --- Этап 6-7: голосовой цикл и API звонков (virtual-caller) ----------
# ML: POST {ML_API_URL}/dialogue/turn — реплики собеседников (ML-сервис полного стенда).
ML_API_URL=http://ml:8000
# Backend: POST {BACKEND_URL}/telephony/events — события звонка (токен — TELEPHONY_WEBHOOK_TOKEN в корневом .env).
BACKEND_URL=http://api:8000/api/v1
# HTTP API звонков на хосте: http://localhost:8092/health
CALL_API_PORT=8092
MOCKS_PORT=8093
# Дозвон до обучающегося, секунд
RING_TIMEOUT_SEC=30
# Лимиты разговора: реплик абонента, длительность звонка, одна реплика оператора
MAX_TURNS=12
MAX_CALL_SEC=300
MAX_UTTERANCE_SEC=20
# Сколько секунд тишины считать концом реплики оператора
SILENCE_SEC=4
# Перебивание: оператор заговорил во время реплики собеседника — тот замолкает (1 / 0)
BARGE_IN=1
# Сколько секунд речи нужно, чтобы перебить (меньше — чаще срабатывает на шум)
BARGE_IN_MIN_SEC=0.3
# Порог речи: средняя амплитуда кадра PCM16 (шумно в классе — выше, тихая гарнитура — ниже)
VAD_THRESHOLD=400
# Гудки перед ответом службы при звонке кнопкой из UI, секунд
RINGBACK_SEC=3
# Откуда frontend может обращаться к API из браузера
CORS_ORIGINS=*
# Откуда Backend/Frontend забирают записи (audio-tools)
RECORDINGS_BASE_URL=http://localhost:8090
# Текст mock STT (при STT_ENGINE=mock) — «что сказал оператор»
MOCK_STT_TEXT=Назовите адрес. Есть пострадавшие? Бригада уже выехала.

# --- Рабочие места обучающихся -------------------------------------------
# SIP-логины ws01..wsNN (софтфон/IP-телефон на каждом АРМ), общий пароль класса
TRAINEE_ACCOUNTS=20
TRAINEE_PASSWORD=change_me_ws_password

# --- LLM для реплик собеседников — в корневом .env: DIALOGUE_ENGINE, DIALOGUE_LLM_MODEL (ML-сервис) ---
