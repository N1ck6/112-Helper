# --- Приложение -------------------------------------------------------------
APP_ENV=local
DEBUG=true
ENABLE_DOCS=true

# --- PostgreSQL (п.2.2: PostgreSQL 12+) -------------------------------------
POSTGRES_HOST=localhost
# Если на компьютере уже работает свой PostgreSQL на 5432, а базу поднимаете
# контейнером — поставьте 5433 здесь, в POSTGRES_HOST_PORT и в TEST_DATABASE_URL.
POSTGRES_PORT=5432
# Порт, на котором docker compose публикует контейнер с базой.
POSTGRES_HOST_PORT=5432
POSTGRES_USER=dds112
POSTGRES_PASSWORD=dds112
POSTGRES_DB=dds112
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_ECHO=false

# База для тестов (pytest)
TEST_DATABASE_URL=postgresql+asyncpg://dds112:dds112@localhost:5432/dds112_test

# --- Безопасность (п.2.3, п.9) ---------------------------------------------
# ОБЯЗАТЕЛЬНО заменить в промышленном контуре: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
# Роли с обязательным вторым фактором. Включайте (например, ["admin"]) только после
# того, как эти пользователи привязали приложение-аутентификатор через /auth/mfa/setup.
MFA_REQUIRED_ROLES=[]
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
SECURITY_LOG_RETENTION_DAYS=200
SYSTEM_LOG_RETENTION_DAYS=90
# Стоимость bcrypt: ниже 10 не опускать. 12 — безопасный уровень для эксплуатации.
PASSWORD_HASH_ROUNDS=12

# --- Учебный процесс (п.2.4) -----------------------------------------------
# Норматив первичного статуса «Принята»/«Не принята» и заполнения карточки
DEFAULT_CARD_TIME_LIMIT_SECONDS=30
# Время на полную отработку карточки в режиме «действия с карточками», секунд.
# Норматив заказчика — 3 минуты (30 секунд относятся только к первичному статусу).
CARD_ACTION_WORK_LIMIT_SECONDS=180
# Сколько карточек одновременно держится в «Списке происшествий» у диспетчера ДДС.
# Карточки приходят потоком: таймеры ожидающих карточек идут параллельно.
CARD_STREAM_WINDOW=3
CARD_STREAM_INTERVAL_SECONDS=20
SESSION_RECOVERY_GRACE_SECONDS=30
MAX_CONCURRENT_SESSIONS=20
# Порог зачёта аттестационного мероприятия, баллов из 100
ATTESTATION_PASS_SCORE=70

# --- Оценка действий --------------------------------------------------------
# Веса критериев. Утверждённой методики заказчик не дал: значения по умолчанию
# задаёт команда, преподаватель переопределяет их в занятии через
# success_criteria.weights. Сумма приводится к 1.0, поэтому можно писать баллами.
SCORE_WEIGHT_CORRECTNESS=0.45
SCORE_WEIGHT_TIME=0.20
SCORE_WEIGHT_GRAMMAR=0.15
SCORE_WEIGHT_SEQUENCE=0.20
# Во сколько раз ошибка в адресе тяжелее обычной. Заказчик выделил адреса особо:
# «Дубнинская» вместо «Дубининской» — другой район и бригада, уехавшая не туда.
SCORE_ADDRESS_ERROR_FACTOR=3.0
# Шкала сложности заданий: заказчик просил веса 1–10.
DIFFICULTY_WEIGHT_MIN=1
DIFFICULTY_WEIGHT_MAX=10
# Адаптивная сложность: шаг и границы баллов для повышения и понижения уровня.
ADAPTIVE_STEP=1
ADAPTIVE_RAISE_SCORE=85
ADAPTIVE_LOWER_SCORE=55
# Памятка АРМ-112: работы не закрыты за 48 часов → карточка «Не завершено»
CARD_COMPLETION_HOURS=48
# Периодичность регламентных задач (очистка журналов, проверка карточек), часов
MAINTENANCE_INTERVAL_HOURS=6

# --- Интеграции (п.2.9) ----------------------------------------------------
# Пока модули команды не готовы — работают заглушки (USE_STUB=true)
ML_SERVICE_URL=http://localhost:8100
ML_USE_STUB=true
ML_TIMEOUT_SECONDS=20
# Метод, который ML-сервис не реализовал (501) или не выполнил, считают правила backend
ML_FALLBACK_TO_RULES=true
TELEPHONY_SERVICE_URL=http://localhost:8200
TELEPHONY_USE_STUB=true
TELEPHONY_WEBHOOK_TOKEN=dev-telephony-token
# Локальная система управления доступом (LDAP/AD-шлюз контура).
# Пусто — работает заглушка: она отдаёт учебный каталог и всегда отклоняет пароль.
# DIRECTORY_URL=http://localhost:8300
MONITORING_ENABLED=true

# --- Файлы -----------------------------------------------------------------
STORAGE_DIR=var
MAX_UPLOAD_MB=50

# --- Резервное копирование (п.2.2, п.9) ------------------------------------
# Включать, когда процессу сервиса доступна утилита pg_dump
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# Путь к pg_dump, если его нет в PATH (Windows: C:/Program Files/PostgreSQL/16/bin/pg_dump.exe)
BACKUP_PG_DUMP=pg_dump

# --- Сборка комплекса (docker-compose.stack.yml) ---------------------------
# Пути к папкам соседних частей команды и порты на хосте
# FRONTEND_PATH=../dds112-trainer-frontend
# ML_PATH=../dds112-trainer-ml
# SIP_PATH=../dds112-trainer-telephony
# API_PORT=8000
# FRONTEND_PORT=5173
# ML_PORT=8100
# SIP_PORT=8200

# --- CORS (локальный контур учебного центра) -------------------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
