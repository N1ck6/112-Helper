# Единого .env для всего репозитория нет — у каждого этапа свой,
# рядом со своим docker-compose.yml (telephony/stageN_.../.env.example),
# т.к. этапы запускаются независимо друг от друга.
#
# Здесь — просто сводка, какие переменные вообще есть в проекте:

AMI_PASSWORD=          # пароль AMI (мониторинг/тесты), у каждого этапа свой .env
SIP_ALICE_PASSWORD=    # пароль SIP-аккаунта alice (с этапа 2)
SIP_BOB_PASSWORD=      # пароль SIP-аккаунта bob (с этапа 2)
