# Сводка переменных окружения проекта (справочно).
# Стенд запускается из корня: docker compose up -d --build — .env не обязателен.
# Настройки телефонии — telephony/.env (шаблон с комментариями — telephony/.env.example),
# корневой compose подхватывает его сам.

# --- Telephony: SIP / AMI ---
AMI_PASSWORD=            # пароль AMI (virtual-caller, автотесты)
SIP_ALICE_PASSWORD=      # SIP-аккаунт alice
SIP_BOB_PASSWORD=        # SIP-аккаунт bob
EXTERNAL_MEDIA_ADDRESS=  # адрес хоста для RTP/SIP, который видит софтфон
EXTERNAL_SIGNALING_PORT= # порт SIP на хосте (5063)

# --- Telephony: STT/TTS (voice-service) ---
STT_ENGINE=              # faster_whisper | mock
TTS_ENGINE=              # piper | mock
WHISPER_MODEL=           # tiny | base | small | medium
PIPER_VOICE=             # например ru_RU-irina-medium
MODELS_AUTO_DOWNLOAD=    # 1 — скачать модели при первом старте
ENGINE_FALLBACK=         # mock — без моделей работать заглушками

# --- Интеграция телефонии с другими ролями (telephony/API.md) ---
# Заглушки ML/Backend (сервис mocks) поднимаются всегда; настоящие — адресами ниже.
ML_API_URL=              # базовый URL ML: POST {ML_API_URL}/dialogue/turn
BACKEND_URL=             # базовый URL Backend: POST {BACKEND_URL}/telephony/events

# --- Корневой стенд (docker-compose.yml в корне) ---
FRONTEND_PORT=           # порт раздачи frontend, по умолчанию 8080
