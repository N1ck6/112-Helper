# Настройки полного стенда (корневой docker-compose.yml). Файл .env необязателен: у всех
# переменных есть значения по умолчанию — учебные, для эксплуатации их нужно сменить.
# Скопировать: cp .env.example .env. Пустое значение = значение по умолчанию.
# Комментарии — только отдельной строкой: «X=  # текст» docker compose прочитает как значение.
# Настройки телефонии (SIP, AMI, STT/TTS, паузы) — telephony/.env (шаблон telephony/.env.example).

# ---------------- Безопасность: сменить перед эксплуатацией ----------------
# Подпись JWT backend: openssl rand -hex 32
SECRET_KEY=
# Пароль PostgreSQL (по умолчанию dds112)
POSTGRES_PASSWORD=
# Общий секрет телефонии и backend для событий звонков
TELEPHONY_WEBHOOK_TOKEN=

# ---------------- Backend / PostgreSQL ----------------
# local | dev | test | prod
APP_ENV=
POSTGRES_USER=
POSTGRES_DB=
# Порт API backend на хосте (8000), документация — /docs
API_PORT=

# ---------------- ML ----------------
# Порт ML API на хосте (8100)
ML_PORT=
# Сколько backend ждёт ML, с (60); не дождался — оценка по правилам backend
ML_TIMEOUT_SECONDS=
# Модель Ollama для анализа текста (профиль llm), qwen3:4b
LLM_MODEL=
# Реплики собеседников в звонках: rules | llm
DIALOGUE_ENGINE=
# Модель для реплик при llm (qwen3:4b-instruct; скачать: docker exec trainer-ollama ollama pull qwen3:4b-instruct)
DIALOGUE_LLM_MODEL=
# Ожидание LLM на одну реплику, с (20); дольше — ответ по правилам
LLM_TIMEOUT_SEC=

# ---------------- Телефония в полном стенде ----------------
# Рабочее место для вызовов backend, если номер АРМ неизвестен (ws01)
DEFAULT_TRAINEE=

# ---------------- Frontend ----------------
# Порт АРМ на хосте (8080)
FRONTEND_PORT=
