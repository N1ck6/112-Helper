# ============================================================================================
#  Настройки учебного тренажёра ДДС-112 — один файл на весь стенд (frontend, backend, ML, LLM,
#  телефония). Рабочая копия — .env рядом с этим файлом; в git она не попадает.
#
#  Проще всего: start.bat (Windows) или ./start.sh (Linux/macOS) — создадут .env сами,
#  с новыми случайными паролями, и запустят стенд. Вручную: скопировать этот файл в .env,
#  заполнить все пустые пароли и ключи, затем `docker compose up -d --build`.
#
#  Пустое значение пароля или ключа = стенд не запустится (так задумано: без паролей по умолчанию).
#  Комментарии — только отдельной строкой: «X=1  # текст» docker compose прочитает как значение.
# ============================================================================================

# -------- Учётные записи тренажёра (создаются при первом запуске) --------
# Вход: http://<адрес стенда>:8080. Смена пароля здесь применяется после перезапуска
# (start.bat / ./start.sh или docker compose up -d); смена в интерфейсе сохраняется,
# пока значение здесь не изменят. Новые учётные записи заводит администратор («Пользователи»).
# admin — администратор системы
ADMIN_PASSWORD=
# teacher — преподаватель
TEACHER_PASSWORD=
# student, student2 — обучающиеся (оператор 112 / диспетчер ДДС, роль выбирается при входе)
STUDENT_PASSWORD=

# -------- Ключи и служебные пароли (людям не нужны, только сервисам) --------
# Подпись токенов входа backend
SECRET_KEY=
# PostgreSQL
POSTGRES_PASSWORD=
# Общий секрет телефонии и backend для событий звонков
TELEPHONY_WEBHOOK_TOKEN=
# Управление Asterisk (AMI)
AMI_PASSWORD=
# SIP-пароль телефонов рабочих мест ws01…wsNN (софтфон / IP-телефон на каждом АРМ)
TRAINEE_PASSWORD=
# Служебные SIP-аккаунты автотестов телефонии
SIP_ALICE_PASSWORD=
SIP_BOB_PASSWORD=

# -------- Сеть --------
# IP этого компьютера в локальной сети: по нему софтфоны других ПК получают звук (RTP).
# Установщик подставляет его сам; софтфон только на этом же ПК — можно 127.0.0.1.
EXTERNAL_MEDIA_ADDRESS=127.0.0.1
# Порты на этом компьютере. В локальную сеть открыты только АРМ (FRONTEND_PORT), SIP и RTP.
# API backend, ML, звонков, синтеза речи, записей и AMI слушают только этот компьютер:
# записи разговоров и управление звонками не должны быть доступны с других ПК класса.
# 0.0.0.0 — открыть их в сеть (только для отладки).
SERVICE_BIND=127.0.0.1
FRONTEND_PORT=8080
API_PORT=8000
ML_PORT=8100
# SIP для софтфонов (UDP/TCP); должен совпадать с портом в настройках софтфона
EXTERNAL_SIGNALING_PORT=5063
CALL_API_PORT=8092
VOICE_SERVICE_PORT=8091

# -------- Искусственный интеллект --------
# llm — локальная LLM (Ollama + модель ниже, ~2.5 ГБ, скачивается один раз при первом запуске).
# Пусто — без LLM: ML работает на классификаторе и правилах, рассказы заявителей — по шаблонам.
COMPOSE_PROFILES=llm
# Модель Ollama: проверка грамотности, рекомендации, рассказы заявителей
LLM_MODEL=qwen3:4b-instruct
# Реплики собеседников в звонках: rules (быстро, по регламенту) | llm (свободный диалог)
DIALOGUE_ENGINE=rules
DIALOGUE_LLM_MODEL=qwen3:4b-instruct
# Ожидание LLM на одну реплику, с; дольше — ответ по правилам
LLM_TIMEOUT_SEC=20
# Сколько backend ждёт ML, с; не дождался — оценка по правилам backend
ML_TIMEOUT_SECONDS=60

# -------- Голос: распознавание (STT) и синтез (TTS) --------
# Модели (~0.8 ГБ) скачиваются при первом запуске: 1 — да
MODELS_AUTO_DOWNLOAD=1
STT_ENGINE=faster_whisper
STT_LANGUAGE=ru
# tiny | base | small | medium: small — компромисс качества и скорости на CPU
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_WORKERS=2
# silero — мягкие естественные голоса (модели CC BY-NC: некоммерческое использование);
# piper — запасной (MIT), для коммерческого использования
TTS_ENGINE=silero
TTS_FALLBACK_ENGINE=piper
SILERO_MODEL=v5_ru
SILERO_VOICES_FEMALE=baya,kseniya,xenia
SILERO_VOICES_MALE=aidar,eugene
PIPER_VOICE=ru_RU-irina-medium
PIPER_VOICE_FEMALE=ru_RU-irina-medium
PIPER_VOICE_MALE=ru_RU-dmitri-medium,ru_RU-denis-medium
# Модели так и не появились (нет интернета) — mock: звонки идут без голоса; none — не запускаться
ENGINE_FALLBACK=mock

# -------- Звонки --------
# Число рабочих мест (SIP-аккаунты ws01…ws20)
TRAINEE_ACCOUNTS=20
# Рабочее место по умолчанию для вызовов backend, если номер АРМ неизвестен
DEFAULT_TRAINEE=ws01
# Сколько секунд тишины считать концом реплики обучающегося
SILENCE_SEC=4
# Перебивание: обучающийся заговорил — собеседник замолкает (1 / 0)
BARGE_IN=1
BARGE_IN_MIN_SEC=0.3
# Порог речи (шумно в классе — выше, тихая гарнитура — ниже)
VAD_THRESHOLD=400
# Дозвон до рабочего места и гудки перед ответом службы, с
RING_TIMEOUT_SEC=30
RINGBACK_SEC=3
# Лимиты разговора: реплик собеседника, длительность звонка и одной реплики, с
MAX_TURNS=12
MAX_CALL_SEC=300
MAX_UTTERANCE_SEC=20

# -------- База данных и резервные копии --------
# local | dev | prod (prod — журналы в JSON)
APP_ENV=prod
POSTGRES_USER=dds112
POSTGRES_DB=dds112
# Копия БД в data/backups: период, часов, и сколько копий хранить
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
